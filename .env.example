# EmailJS contact-form credentials. Used by src/components/contact_form/ContactForm.js.
# Copy this file to .env.local and fill in real values from https://dashboard.emailjs.com/.
# .env.local is ignored by git; do not commit it.
#
# The VITE_ prefix is required by Vite for env vars to be exposed to client code.
VITE_EMAILJS_USER_ID=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
